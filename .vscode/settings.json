    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/site-packages/**": true,
    "**/models/**": true,
    "**/checkpoints/**": true,
    "**/datasets/**": true,
    "**/results/**": true,
    "**/experiments/**": true
  },
  "search.exclude": {
    "**/.git/**": true,
    "**/.venv/**": true,
    "**/src/vllm/.venv/**": true,
    "**/venv/**": true,
    "**/__pycache__/**": true,
    "**/build/**": true,
    "**/dist/**": true,
    "**/.pytest_cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/site-packages/**": true,
    "**/models/**": true,
    "**/checkpoints/**": true,
    "**/datasets/**": true,
    "**/results/**": true,
    "**/experiments/**": true
  },
  "python.analysis.exclude": [
    "**/.venv",
    "**/src/vllm/.venv",
    "**/venv",
    "**/build",
    "**/dist",
    "**/__pycache__",
    "**/.pytest_cache",
